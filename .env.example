# Exemplo de variáveis de ambiente para o Transcripto
# Renomeie este arquivo para .env e preencha com suas chaves reais

OPENAI_API_KEY=


# Futuras integrações (ainda não implementadas)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# AZURE_API_KEY=your_azure_api_key_here
# AWS_ACCESS_KEY_ID=your_aws_access_key_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# --- Transcrição local (faster-whisper via scripts Python) ---
# Preencha para habilitar o provedor "Local" no seletor. A porta, o modelo e a ociosidade do
# servidor ficam no .env da pasta dos scripts (ex.: C:\DEV\IA\poc-lvk\.env)
# LOCAL_WHISPER_PYTHON=C:\DEV\IA\poc-lvk\Scripts\python.exe
# LOCAL_WHISPER_TRANSCRIBE_SCRIPT=C:\DEV\IA\poc-lvk\transcrever.py
# LOCAL_WHISPER_DIARIZE_SCRIPT=C:\DEV\IA\poc-lvk\transcrever_diarizado.py
# LOCAL_WHISPER_SERVER_SCRIPT=C:\DEV\IA\poc-lvk\whisper_server.py   # opcional (padrão: whisper_server.py ao lado do script)
# LOCAL_WHISPER_AUTOSTART=true   # sobe o servidor sozinho ao pedir a 1ª transcrição; false = só manual/botão
